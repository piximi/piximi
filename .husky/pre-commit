#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Get staged files that should be linted
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx)$' || true)

if [ -n "$STAGED_FILES" ]; then
  echo "Linting staged files..."
  pnpm run lint $STAGED_FILES
else
  echo "No lintable files staged, skipping lint"
fi

pnpm run no-console-logs



# enable for testing, run `HUSKY_DEBUG=true git commit -m "..."``
