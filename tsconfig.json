{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noErrorTruncation": true,
    "paths": {
      "*": ["./src/*"],
      "@ProjectViewer/*": ["./src/views/ProjectViewer/*"],
      "@ImageViewer/*": ["./src/views/ImageViewer/*"],
      "@MeasurementViewer/*": ["./src/views/MeasurementViewer/*"]
    }
  },
  "include": ["src", "src/icons/svg.d.ts"],
  "sourcemap": true
}
